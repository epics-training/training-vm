# {{ ansible_managed }}
[Unit]
Description=ChannelFinder directory service
Documentation=https://channelfinder.readthedocs.io
After=network.target elasticsearch.service
Requires=elasticsearch.service

[Service]
Type=simple
User={{ channelfinder_account }}
Group={{ channelfinder_account }}
WorkingDirectory={{ channelfinder_root }}

Environment=JAVA_HOME={{ java_home }}
ExecStart={{ java_home }}/bin/java {{ channelfinder_java_heap_opts }} -jar {{ channelfinder_jar }} --spring.config.additional-location=file:{{ channelfinder_root }}/application.properties
# JVM exit code on SIGTERM
SuccessExitStatus=143

LimitNOFILE=65535

# Elasticsearch is slow to come up after a boot
Restart=on-failure
RestartSec=10s

[Install]
WantedBy=multi-user.target
