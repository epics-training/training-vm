# {{ ansible_managed }}
#
# Build-time configuration of the Olog web client: overrides the
# placeholders in .env.production (the values are compiled into the build)

# Olog service, as seen from the browser
VITE_APP_BACKEND_URL={{ olog_webclient_backend_url }}
VITE_APP_WEBSOCKET_BASE_URL={{ olog_webclient_websocket_url }}

# Served at the root of its own port
VITE_APP_PUBLIC_PATH=/

VITE_APP_SUPPORT_HREF={{ olog_webclient_support_href }}
VITE_APP_SWAGGER_URL={{ olog_webclient_swagger_url }}
VITE_APP_APP_TITLE="{{ olog_webclient_app_title }}"
