# {{ ansible_managed }}
[Unit]
Description=Phoebus Save-and-Restore Service
Documentation=https://github.com/ControlSystemStudio/phoebus/tree/master/services/save-and-restore
After=network.target elasticsearch.service
Requires=elasticsearch.service

[Service]
Type=simple
User={{ save_restore_user }}
Group={{ save_restore_group }}
WorkingDirectory={{ save_restore_home }}

Environment="SAVE_RESTORE_JAVA_OPTS={{ save_restore_java_heap_opts }}"
{% if save_restore_epics_env %}
# EPICS access (CA and PVA) for taking snapshots and restoring
{% for name, value in save_restore_epics_env | dictsort %}
Environment="{{ name }}={{ value }}"
{% endfor %}
{% endif %}

ExecStart=/usr/local/bin/save-and-restore
SuccessExitStatus=143

LimitNOFILE=65535

# Elasticsearch takes a while to come up after a (re)boot
Restart=on-failure
RestartSec=10s

[Install]
WantedBy=multi-user.target
